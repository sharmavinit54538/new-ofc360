APP_NAME=EduFlow AI
ENVIRONMENT=development

# Postgres in production. For quick local/dev testing without Postgres,
# you can use: sqlite+aiosqlite:///./eduflow.db
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eduflow_ai

JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=25
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma separated. Must match the frontend origin(s) exactly (withCredentials=true).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

FACE_RECOGNITION_THRESHOLD=0.55

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Seed script credentials (dev only — never hardcode in production).
SEED_ADMIN_PASSWORD=Admin@12345
SEED_TEACHER_PASSWORD=Teacher@12345
SEED_STUDENT_PASSWORD=Student@12345
SEED_PARENT_PASSWORD=Parent@12345
SEED_ACCOUNTANT_PASSWORD=Account@12345
