# OFC360 Production Environment Configuration
# This file is used when running `npm run build` for production deployment

# API Base URL (Production Backend)
VITE_API_BASE_URL=https://api.ofc360.com
VITE_API_URL=https://api.ofc360.com

# Frontend Production URL - Update with actual deployed domain
VITE_PUBLIC_APP_URL=https://app.ofc360.com

# OFC360 AI Configuration — One AI Model (Ollama / qwen3:30b)
VITE_AI_PROVIDER=ollama
VITE_AI_MODEL=qwen3:30b
VITE_AI_API_KEY=
VITE_AI_TEMPERATURE=0.7
VITE_AI_MAX_TOKENS=4096
VITE_AI_TIMEOUT=30000
VITE_AI_STREAMING=false

# Feature Flags
VITE_ENABLE_AI_RECRUITMENT=true
VITE_ENABLE_AI_PAYROLL=true
VITE_ENABLE_AI_ATTENDANCE=true
VITE_ENABLE_AI_INTELLIGENCE=true