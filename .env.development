# OFC360 Development Environment Configuration
# This file is used when running `npm run dev`

# API Base URL (local development backend)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Frontend Development URL
VITE_PUBLIC_APP_URL=http://localhost:8080

# AI Configuration
VITE_AI_PROVIDER=backend
VITE_AI_MODEL=gpt-4
VITE_AI_API_KEY=
VITE_AI_TEMPERATURE=0.7
VITE_AI_MAX_TOKENS=4096
VITE_AI_TIMEOUT=30000
VITE_AI_STREAMING=false

# Feature Flags
VITE_ENABLE_AI_RECRUITMENT=true
VITE_ENABLE_AI_PAYROLL=true
VITE_ENABLE_AI_ATTENDANCE=true
VITE_ENABLE_AI_INTELLIGENCE=true