# OFC360 AI Configuration
# Copy this file to .env.local and fill in your values

# AI Provider (backend = uses backend API endpoints)
VITE_AI_PROVIDER=backend

# Canonical AI Model (used by backend)
VITE_AI_MODEL=gpt-4

# API Base URL (backend)
VITE_API_BASE_URL=https://api.ofc360.com

# AI API Key (if using direct provider)
VITE_AI_API_KEY=

# Generation Settings
VITE_AI_TEMPERATURE=0.7
VITE_AI_MAX_TOKENS=4096
VITE_AI_TIMEOUT=30000
VITE_AI_STREAMING=false

# Feature Flags
VITE_ENABLE_AI_RECRUITMENT=true
VITE_ENABLE_AI_PAYROLL=true
VITE_ENABLE_AI_ATTENDANCE=true
VITE_ENABLE_AI_INTELLIGENCE=true